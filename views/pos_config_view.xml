<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_cash_limit_pos_config_view_form" model="ir.ui.view">
        <field name="name">pos_cash_limit.pos.config.form.viewt</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">

            <sheet position="inside">
                <setting string="Pos cash limit"
                         help="Configura el efectivo máximo, la secuencia y el diario para los retiros de efectivo.">
                    <div class="content-group mt16">
                        <div class="row mb-3">
                            <div class="col-lg-4 o_light_label">
                                <label for="efectivo_maximo"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="efectivo_maximo"/>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-lg-4 o_light_label">
                                <label for="secuencia_id"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="secuencia_id" options="{'no_create': True}"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-4 o_light_label">
                                <label for="diario_efectivo_id"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="diario_efectivo_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </sheet>

        </field>
    </record>

</odoo>
